# Unified Docker deployment (frontend and backend).
WEB_PORT=5173
GATEWAY_PORT=18000

# 本地开发占位配置；部署前请替换所有 change-* 和 nacos 默认值。
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_AUTH_IDENTITY_KEY=agent
NACOS_AUTH_IDENTITY_VALUE=change-identity
NACOS_AUTH_TOKEN=change-token
MYSQL_DATABASE=agent
MYSQL_USERNAME=agent
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
REDIS_PASSWORD=change-redis-me
# Base64 encoded 32-byte AES key; generate one before enabling API-key settings.
API_KEY_ENCRYPTION_KEY=
# Base64 encoded 32-byte HMAC key for service-to-service principals.
# Comma-separated keyId=Base64 pairs. Keep old key during rotation, then remove it after TTL.
INTERNAL_PRINCIPAL_SECRETS=
INTERNAL_PRINCIPAL_ACTIVE_KEY_ID=current
CORS_ALLOWED_ORIGINS=https://www.boboo.xin,https://boboo.xin,http://localhost:*,http://127.0.0.1:*
FORCE_COOKIE_SECURE=false

# Unified operator credentials (Auth only). Never expose to browsers.
PLATFORM_API_KEY=
PLATFORM_CHAT_MODEL=qwen-turbo
PLATFORM_VISION_MODEL=qwen-vl-plus
PLATFORM_IMAGE_MODEL=qwen-image-3.0-pro
PLATFORM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLATFORM_EMBEDDING_MODEL=text-embedding-v4
RAG_DENSE_RRF_WEIGHT=1.0
RAG_RERANK_MINIMUM=0.25
PLATFORM_RERANK_MODEL=qwen3-rerank
# Set the rerank base for your Model Studio region/workspace; the client appends /reranks.
PLATFORM_RERANK_BASE_URL=
PLATFORM_EVALUATION_MODEL=qwen-plus
PLATFORM_FALLBACK_MODEL=qwen-plus
PLATFORM_FALLBACK_PROVIDER=QWEN
PLATFORM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Blank uses PLATFORM_API_KEY. An independent provider requires its own base/key.
PLATFORM_FALLBACK_API_KEY=
# Explicit operator policy: absorb bounded platform-caused duplicate cost.
BILLING_PLATFORM_FAULT_ENABLED=false
BILLING_PLATFORM_FAULT_GROUP_CAP_MICROS=400000
BILLING_PLATFORM_FAULT_WINDOW_CAP_MICROS=2000000
BILLING_PLATFORM_FAULT_UNRESOLVED_CAP=10
TRACE_SAMPLING_PROBABILITY=0.1
MILVUS_TOKEN=
MODEL_FIRST_OUTPUT_TIMEOUT_SECONDS=15
MODEL_IDLE_TIMEOUT_SECONDS=20
MODEL_TOTAL_TIMEOUT_SECONDS=60
MODEL_FALLBACK_TIMEOUT_SECONDS=30
AUTH_OTP_SECRET=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
SMTP_STARTTLS=false
# Development prices; confirm before production. 1 yuan = 1000000 micros.
BILLING_TOKEN_PRICE_PER_1K_MICROS=10000
BILLING_TEXT_RESERVE_MICROS=200000
BILLING_IMAGE_PRICE_MICROS=1000000
BILLING_LOW_BALANCE_MICROS=500000
BILLING_ADMIN_USER_IDS=
PAYMENT_NOTIFY_BASE_URL=
PAYMENT_KEYS_DIR=./secrets/payments
ALIPAY_ENABLED=false
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=/run/payment-keys/alipay-private.pem
ALIPAY_PUBLIC_KEY_PATH=/run/payment-keys/alipay-public.pem
WECHAT_PAY_ENABLED=false
WECHAT_APP_ID=
WECHAT_MERCHANT_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=/run/payment-keys/wechat-private.pem
WECHAT_API_V3_KEY=
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=/run/payment-keys/wechat-public.pem
