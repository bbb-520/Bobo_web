{
  "name": "travel-agent-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "旅行助手 Agent 前端 —— 对接 AgentDemo(Spring Boot WebFlux + Spring AI) 的 SSE 协议",
  "scripts": {
    "dev": "node server.mjs",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "node server.mjs",
    "start": "node server.mjs",
    "typecheck": "tsc -b --pretty false",
    "test:storage": "node scripts/test-storage-uid.mjs",
    "test:cloud-recovery": "node --import=./scripts/csrf-test-env.mjs --import=tsx --test scripts/test-conversation-sync.ts scripts/test-cloud-recovery.tsx",
    "test:image-job-404": "node --experimental-strip-types --test scripts/test-image-job-404.mjs",
    "test:image-job-reconcile": "node --experimental-strip-types --test scripts/test-image-job-reconcile.mjs",
    "test:accounts-billing": "node --import=./scripts/csrf-test-env.mjs --experimental-strip-types --test scripts/test-accounts-billing.mjs",
    "test:billing-recovery": "node --import=./scripts/csrf-test-env.mjs --import=tsx --test scripts/test-billing-recovery.tsx",
    "test:account-races": "node --import=./scripts/csrf-test-env.mjs --import=tsx --test scripts/test-account-races.tsx",
    "test:proxy-cancellation": "node --test scripts/test-proxy-cancellation.mjs",
    "test:executions": "node --import=./scripts/csrf-test-env.mjs --import=tsx --test scripts/test-executions.mjs scripts/test-execution-recovery.tsx",
    "test:documents": "node --import=./scripts/csrf-test-env.mjs --import=tsx --test scripts/test-documents.mjs scripts/test-document-ui.tsx",
    "test:rbac": "node --import=tsx --test scripts/test-rbac-http.mjs scripts/test-rbac-ui.tsx",
    "test:payment-recovery": "node --import=./scripts/csrf-test-env.mjs --import=tsx --test scripts/test-payment-recovery.tsx",
    "test:photo-archive": "node --test scripts/test-photo-archive.mjs",
    "test:unified-chat": "node --import=./scripts/csrf-test-env.mjs --import=tsx --test scripts/test-unified-chat.tsx",
    "test:ui-polish": "node --import=tsx --test scripts/test-ui-polish.tsx",
    "test:chat-modes": "node --import=./scripts/csrf-test-env.mjs --import=tsx --test scripts/test-chat-modes.tsx",
    "test:image-creation": "node --import=./scripts/csrf-test-env.mjs --import=tsx --test scripts/test-image-creation.tsx",
    "test:ci-contract": "node --test e2e/ci-contract.test.mjs",
    "test:e2e": "playwright test",
    "e2e:serve": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "@use-gesture/react": "^10.3.1",
    "gsap": "^3.15.0",
    "maath": "^0.10.8",
    "motion": "^13.4.0",
    "ogl": "^1.0.11",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.7.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.8"
  }
}
